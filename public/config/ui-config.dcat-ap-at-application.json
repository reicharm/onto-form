{
  "standard": "dcat-ap-at-application",
  "version": "1.1",
  "rootClass": "dcatapat:Application",
  "wizard": false,
  "groups": [
    {
      "id": "basic",
      "label": { "de": "Grundinformationen", "en": "Basic Information" },
      "fields": ["dct:title", "dct:description", "dct:identifier", "dcat:theme"]
    },
    {
      "id": "access",
      "label": { "de": "Zugang", "en": "Access" },
      "fields": ["foaf:homepage", "ckan:urlLabel", "ckan:sourceUrl", "dcat:servesDataset"]
    },
    {
      "id": "contact",
      "label": { "de": "Kontakt & Herausgeber", "en": "Contact & Publisher" },
      "fields": ["dct:publisher", "dcat:contactPoint"]
    },
    {
      "id": "dates",
      "label": { "de": "Zeitangaben", "en": "Dates" },
      "fields": ["dct:issued", "dct:created", "dct:modified"]
    }
  ],
  "fields": {
    "dct:title": {
      "type": "langstring",
      "multiple": false,
      "required": true,
      "label": { "de": "Titel", "en": "Title" },
      "placeholder": { "de": "Titel der Applikation", "en": "Application title" },
      "errorMessages": {
        "required": { "de": "Titel ist erforderlich", "en": "Title is required" }
      },
      "defaultValue": { "de": "", "en": "" },
      "order": 1,
      "visible": true
    },
    "dct:description": {
      "type": "textarea",
      "multiple": false,
      "label": { "de": "Beschreibung", "en": "Description" },
      "placeholder": { "de": "Kurzbeschreibung der Applikation …", "en": "Short description of the application …" },
      "order": 2,
      "visible": true
    },
    "dct:identifier": {
      "type": "text",
      "multiple": false,
      "label": { "de": "Kennung", "en": "Identifier" },
      "hint": { "de": "Eindeutige Kennung der Applikation", "en": "Unique identifier of the application" },
      "order": 3,
      "visible": true
    },
    "dcat:theme": {
      "type": "multiselect",
      "multiple": false,
      "label": { "de": "Themen", "en": "Themes" },
      "hint": { "de": "Thematische Kategorisierung der Applikation", "en": "Thematic categorisation of the application" },
      "optionsSource": "/vocabularies/themes.json",
      "order": 4,
      "visible": true
    },
    "foaf:homepage": {
      "type": "uri",
      "multiple": false,
      "label": { "de": "Webseite", "en": "Homepage" },
      "hint": { "de": "URL der Applikation", "en": "URL of the application" },
      "placeholder": { "de": "https://…", "en": "https://…" },
      "order": 5,
      "visible": true
    },
    "ckan:urlLabel": {
      "type": "text",
      "multiple": false,
      "label": { "de": "URL-Bezeichnung", "en": "URL Label" },
      "hint": { "de": "Anzeigetext für die Webseite", "en": "Display text for the homepage link" },
      "order": 6,
      "visible": true
    },
    "ckan:sourceUrl": {
      "type": "uri",
      "multiple": false,
      "label": { "de": "Quell-URL", "en": "Source URL" },
      "hint": { "de": "Ursprüngliche Quelle der Applikation", "en": "Original source URL of the application" },
      "placeholder": { "de": "https://…", "en": "https://…" },
      "order": 7,
      "visible": true
    },
    "dcat:servesDataset": {
      "type": "uri",
      "multiple": true,
      "label": { "de": "Bediente Datensätze", "en": "Serves Dataset" },
      "hint": { "de": "Datensätze, die diese Applikation verwendet oder visualisiert", "en": "Datasets that this application uses or visualises" },
      "placeholder": { "de": "https://…", "en": "https://…" },
      "order": 8,
      "visible": true
    },
    "dct:publisher": {
      "type": "text",
      "multiple": false,
      "label": { "de": "Herausgeber", "en": "Publisher" },
      "hint": { "de": "Name der herausgebenden Organisation oder Person", "en": "Name of the publishing organisation or person" },
      "order": 9,
      "visible": true
    },
    "dcat:contactPoint": {
      "type": "object",
      "multiple": false,
      "label": { "de": "Kontaktstelle", "en": "Contact Point" },
      "order": 10,
      "visible": true,
      "subFields": [
        {
          "id": "vcard:fn",
          "type": "text",
          "label": { "de": "Name", "en": "Name" },
          "placeholder": { "de": "Vor- und Nachname", "en": "Full name" }
        },
        {
          "id": "vcard:hasEmail",
          "type": "text",
          "label": { "de": "E-Mail", "en": "Email" },
          "placeholder": { "de": "kontakt@beispiel.at", "en": "contact@example.at" }
        },
        {
          "id": "vcard:hasURL",
          "type": "uri",
          "label": { "de": "Webseite", "en": "Website" },
          "placeholder": { "de": "https://…", "en": "https://…" }
        }
      ]
    },
    "dct:issued": {
      "type": "date",
      "multiple": false,
      "label": { "de": "Veröffentlichungsdatum", "en": "Date Issued" },
      "order": 11,
      "visible": true
    },
    "dct:created": {
      "type": "date",
      "multiple": false,
      "label": { "de": "Erstellungsdatum", "en": "Date Created" },
      "order": 12,
      "visible": true
    },
    "dct:modified": {
      "type": "date",
      "multiple": false,
      "label": { "de": "Änderungsdatum", "en": "Date Modified" },
      "order": 13,
      "visible": true
    }
  },
  "showProgress": false
}
