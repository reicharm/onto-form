pv:DCAT_AP_AT_DMP
    a pv:PiveauProfile ;
    pv:profileVersion "1.1" ;
    dct:title "A DCAT-AP-AT profile for piveau"@en ;
    dct:description "Based and inspired by DCAT-AP 2.2.0-HVD"@en ;
    foaf:maker [
        foaf:mbox <mailto:data@brz.gv.at> ;
        foaf:name "OpenData Österreich" ;
    ] ;
    owl:versionInfo "0.0.1" .

<http://data.europa.eu/r5r/shacl_shapes>
    dcat:accessURL <https://joinup.ec.europa.eu/solution/dcat-application-profile-data-portals-europe/distribution/dcat-ap-200-shacl-shapes>;
