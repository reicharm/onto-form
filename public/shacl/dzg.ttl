    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "centroid"
  ], [
    sh:path locn:geometry ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "geometry"
  ] .

dzg:PeriodOfTimeShape
  a sh:NodeShape ;
  sh:targetClass dct:PeriodOfTime ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path dcat:startDate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "start_date"
  ], [
    sh:path dcat:endDate ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Warning ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "end_date"
  ], [
    sh:path time:hasBeginning ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "beginning"
  ], [
    sh:path time:hasEnd ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "end"
  ] .

dzg:PolicyShape
  a sh:NodeShape ;
  sh:targetClass odrl:Policy .

dzg:ActivityShape
  a sh:NodeShape ;
  sh:targetClass prov:Activity ;

  # Metadata fields and their index mappings.
  sh:property [
    # Dataproduct: survey method ("Erhebungsform"), concept from erh:
    sh:path dct:type ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "type"
  ], [
    sh:path dct:description ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "description"
  ] .

dzg:AttributionShape
  a sh:NodeShape ;
  sh:targetClass prov:Attribution .

dzg:RoleShape
  a sh:NodeShape ;
  sh:targetClass dcat:Role .

dzg:ResourceShape
  a sh:NodeShape ;
  sh:targetClass dcat:Resource .

dzg:GeometryShape
  a sh:NodeShape ;
  sh:targetClass locn:Geometry .

dzg:DocumentShape
  a sh:NodeShape ;
  sh:targetClass foaf:Document .

dzg:FrequencyShape
  a sh:NodeShape ;
  sh:targetClass dct:Frequency .

dzg:LinguisticSystemShape
  a sh:NodeShape ;
  sh:targetClass dct:LinguisticSystem .

dzg:MediaTypeShape
  a sh:NodeShape ;
  sh:targetClass dct:MediaType .

dzg:MediaTypeOrExtentShape
  a sh:NodeShape ;
  sh:targetClass dct:MediaTypeOrExtent .

dzg:ProvenanceStatementShape
  a sh:NodeShape ;
  sh:targetClass dct:ProvenanceStatement ;

  # Metadata fields and their index mappings.
  sh:property [
    # Dataproduct: data sources ("Datenquellen") as free text.
    sh:path rdfs:label ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "label"
  ] .

dzg:RightsStatementShape
  a sh:NodeShape ;
  sh:targetClass dct:RightsStatement .

dzg:StandardShape
  a sh:NodeShape ;
  sh:targetClass dct:Standard .

dzg:ChecksumAlgorithmShape
  a sh:NodeShape ;
  sh:targetClass spdx:ChecksumAlgorithm .

dzg:TimeInstantShape
  a sh:NodeShape ;
  sh:targetClass time:Instant .

dzg:ConceptShape
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "pref_label"
  ] .

dzg:ConceptSchemeShape
  a sh:NodeShape ;
  sh:targetClass skos:ConceptScheme ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "title"
  ] .

dzg:LegalResourceShape
  a sh:NodeShape ;
  sh:targetClass eli:LegalResource .

# Keep inverse SHACL validation outside the directly indexed property list.
dzg:DatasetSeriesMembershipValidationShape
  a sh:NodeShape ;
  sh:property [
    sh:path [ sh:inversePath dcat:inSeries ] ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation
  ] .

# Keep the RDF cardinality separate from the Search JSON array representation.
dzg:DatasetLanguageValidationShape
  a sh:NodeShape ;
  sh:property [
    sh:path dct:language ;
    sh:maxCount 1
  ] .

# ---------------------------------------------------------------------------
# Dataproduct (since 1.1)
#
# A dataproduct is a dcat:Dataset with dct:type restype:Dataproduct. It bundles
# datasets and dataset series of the same catalogue; members point to it with
# dct:isPartOf. The shapes below are pure validation shapes without index
# mappings (same pattern as dzg:DatasetLanguageValidationShape).
#
# Checks across records cannot be expressed here because each record is
# validated on its own graph. dzg-review has to check them:
#   - the dct:isPartOf target is a dataproduct of the same catalogue,
#   - a member is not itself a dataproduct (no nesting).
# ---------------------------------------------------------------------------

dzg:DataproductTypeShape
  a sh:NodeShape ;
  rdfs:comment "Matches a dataproduct (dct:type restype:Dataproduct)."@en ;
  sh:property [
    sh:path dct:type ;
    sh:hasValue restype:Dataproduct
  ] .

dzg:NotDataproductShape
  a sh:NodeShape ;
  rdfs:comment "Matches every dataset that is not a dataproduct."@en ;
  sh:not dzg:DataproductTypeShape .

# Mandatory fields of a regular dataset (DCAT-AP AT 2.1 / DZG). They were
# sh:minCount 1 in dzg:DatasetShape before 1.1 and do not apply to dataproducts.
dzg:DatasetMandatoryValidationShape
  a sh:NodeShape ;
  sh:node dzg:DatasetRequiresIdentifier , dzg:DatasetRequiresContactPoint ,
    dzg:DatasetRequiresKeyword , dzg:DatasetRequiresPublisher ,
    dzg:DatasetRequiresTheme , dzg:DatasetRequiresAccessRights ,
    dzg:DatasetRequiresRights , dzg:DatasetRequiresAccrualPeriodicity ,
    dzg:DatasetRequiresStatUnit , dzg:DatasetRequiresLanguage ,
    dzg:DatasetRequiresModified , dzg:DatasetRequiresIssued ,
    dzg:DatasetRequiresTemporal , dzg:DatasetRequiresDistribution ,
    dzg:NonPublicDistributionRequiresTitle .

dzg:DatasetRequiresIdentifier a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:identifier ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:identifier ist verpflichtend."@de .
dzg:DatasetRequiresContactPoint a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dcat:contactPoint ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dcat:contactPoint ist verpflichtend."@de .
dzg:DatasetRequiresKeyword a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dcat:keyword ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dcat:keyword ist verpflichtend."@de .
dzg:DatasetRequiresPublisher a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:publisher ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:publisher ist verpflichtend."@de .
dzg:DatasetRequiresTheme a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dcat:theme ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dcat:theme ist verpflichtend."@de .
dzg:DatasetRequiresAccessRights a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:accessRights ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:accessRights ist verpflichtend."@de .
dzg:DatasetRequiresRights a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:rights ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:rights ist verpflichtend."@de .
dzg:DatasetRequiresAccrualPeriodicity a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:accrualPeriodicity ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:accrualPeriodicity ist verpflichtend."@de .
dzg:DatasetRequiresStatUnit a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path stat:statUnit ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: stat:statUnit ist verpflichtend."@de .
dzg:DatasetRequiresLanguage a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:language ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:language ist verpflichtend."@de .
dzg:DatasetRequiresModified a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:modified ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:modified ist verpflichtend."@de .
dzg:DatasetRequiresIssued a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:issued ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:issued ist verpflichtend."@de .
dzg:DatasetRequiresDistribution a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dcat:distribution ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: mindestens eine Distribution ist verpflichtend."@de .
# "Scientific Use Files": the distribution name is mandatory for every
# distribution of a dataset with access rights NON_PUBLIC (decision 2026-11-27).
dzg:NonPublicDistributionRequiresTitle a sh:NodeShape ;
  sh:or (
    [ sh:not [ sh:path dct:accessRights ;
               sh:hasValue <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ] ]
    [ sh:path dcat:distribution ;
      sh:node [ sh:property [ sh:path dct:title ; sh:minCount 1 ] ] ]
  ) ;
  sh:message "Distribution: bei nicht öffentlichen Datensätzen (NON_PUBLIC) ist der Distributionsname verpflichtend."@de .
dzg:DatasetRequiresTemporal a sh:NodeShape ;
  sh:or ( dzg:DataproductTypeShape [ sh:path dct:temporal ; sh:minCount 1 ] ) ;
  sh:message "Datensatz: dct:temporal ist verpflichtend."@de .

# Rules that only apply to dataproducts.
dzg:DataproductValidationShape
  a sh:NodeShape ;
  sh:node dzg:DataproductRequiresValid , dzg:DataproductHasNoDistribution ,
    dzg:DataproductIsNotPartOf , dzg:DataproductIsNotInSeries ,
    dzg:DataproductSurveyMethod , dzg:DataproductHasNoHvd .

dzg:DataproductRequiresValid a sh:NodeShape ;
  sh:or ( dzg:NotDataproductShape [ sh:path dct:valid ; sh:minCount 1 ] ) ;
  sh:message "Datenprodukt: dct:valid mit dcat:startDate (gültig seit) ist verpflichtend."@de .
dzg:DataproductHasNoDistribution a sh:NodeShape ;
  sh:or ( dzg:NotDataproductShape [ sh:path dcat:distribution ; sh:maxCount 0 ] ) ;
  sh:message "Datenprodukt: ein Datenprodukt hat keine Distributionen."@de .
dzg:DataproductIsNotPartOf a sh:NodeShape ;
  sh:or ( dzg:NotDataproductShape [ sh:path dct:isPartOf ; sh:maxCount 0 ] ) ;
  sh:message "Datenprodukt: Datenprodukte werden nicht verschachtelt (kein dct:isPartOf)."@de .
dzg:DataproductIsNotInSeries a sh:NodeShape ;
  sh:or ( dzg:NotDataproductShape [ sh:path dcat:inSeries ; sh:maxCount 0 ] ) ;
  sh:message "Datenprodukt: ein Datenprodukt gehört keiner Datensatzserie an."@de .
dzg:DataproductSurveyMethod a sh:NodeShape ;
  sh:or ( dzg:NotDataproductShape
    [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:node dzg:SurveyMethodValidationShape ] ) ;
  sh:message "Datenprodukt: höchstens eine Erhebungsform aus dem Vokabular erh:; eine Beschreibung ist nur bei erh:andere erlaubt."@de .
dzg:DataproductHasNoHvd a sh:NodeShape ;
  sh:or ( dzg:NotDataproductShape
    [ sh:node [
        sh:property [ sh:path dcatap:hvdCategory ; sh:maxCount 0 ] ;
        sh:property [ sh:path dcatap:applicableLegislation ;
                      sh:not [ sh:hasValue <http://data.europa.eu/eli/reg_impl/2023/138/oj> ] ] ] ] ) ;
  sh:message "Datenprodukt: HVD-Kennzeichnung gehört an die Bestandteile, nicht an das Datenprodukt."@de .

# Survey method ("Erhebungsform") of a dataproduct.
dzg:SurveyMethodValidationShape
  a sh:NodeShape ;
  sh:property [
    sh:path dct:type ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( erh:stichprobe-manuell erh:stichprobe-zufall erh:stichprobe-abschneidegrenze
            erh:vollerhebung-abschneidegrenze erh:vollerhebung erh:andere )
  ] ;
  # The description is optional and only allowed with erh:andere.
  sh:or (
    [ sh:property [ sh:path dct:type ; sh:hasValue erh:andere ] ]
    [ sh:property [ sh:path dct:description ; sh:maxCount 0 ] ]
  ) .

# Members of a dataproduct: a dataset in a series belongs to the dataproduct
# through its series only.
dzg:DatasetMembershipValidationShape
  a sh:NodeShape ;
  sh:node dzg:DatasetSeriesMemberNotPartOf , dzg:DatasetRequiresDataproduct .

dzg:DatasetSeriesMemberNotPartOf a sh:NodeShape ;
  sh:or (
    [ sh:path dcat:inSeries ; sh:maxCount 0 ]
    [ sh:path dct:isPartOf ; sh:maxCount 0 ]
  ) ;
  sh:message "Ein Datensatz in einer Serie gehört über die Serie zum Datenprodukt und hat kein eigenes dct:isPartOf."@de .

# The class Dataproduct is mandatory (Fachbereich, 2026-11-24): every dataset
# that is not itself a dataproduct belongs to one, directly (dct:isPartOf) or
# through its series (dcat:inSeries).
dzg:DatasetRequiresDataproduct a sh:NodeShape ;
  sh:or (
    dzg:DataproductTypeShape
    [ sh:path dct:isPartOf ; sh:minCount 1 ]
    [ sh:path dcat:inSeries ; sh:minCount 1 ]
  ) ;
  sh:message "Datensatz: Zuordnung zu einem Datenprodukt ist verpflichtend (dct:isPartOf oder über die Datensatzserie)."@de .

# Dataset series: the frequency description is optional and only allowed
# with frequency OTHER ("andere"), DZG user story "Klasse Datensatzserie".
dzg:DatasetSeriesFrequencyValidationShape
  a sh:NodeShape ;
  sh:or (
    [ sh:path dct:accrualPeriodicity ;
      sh:hasValue <http://publications.europa.eu/resource/authority/frequency/OTHER> ]
    [ sh:path dcatat:frequencyDescription ; sh:maxCount 0 ]
  ) ;
  sh:message "Datensatzserie: eine Beschreibung der Aktualisierungshäufigkeit ist nur bei „andere“ (frequency/OTHER) erlaubt."@de .
