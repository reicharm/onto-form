@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix pv: <https://piveau.eu/ns/voc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix stat: <http://data.europa.eu/s66#> .
@prefix dzg: <https://data.gv.at/shapes/dcat-ap-at-dzg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix restype: <http://dcat-ap.at/concept/resourcetype/> .
@prefix erh: <http://dcat-ap.at/concept/erhebungsform/> .
@prefix dcatat: <http://dcat-ap.at/ns#> .

# DZG DCAT-AP 3.0.1 metadata model.
#
# Vocabulary basis: DCAT-AP 3.0.1, compatible with W3C DCAT 3.
# Austrian constraints: DCAT-AP AT 2.1.0 (19 June 2024). Its mandatory
# properties remain mandatory; DCAT-AP 3.0.1 properties are modelled here.
# Source SHACL reference: https://semiceu.github.io/DCAT-AP/releases/3.0.1/
#
# Technical index fields follow the OGD/DMP schema. Their pathless mapping
# declarations are excluded from validation by the existing Repo validator.
#
# Change log
# 1.1 (2026-11-23) Dataproduct:
#   - A dataproduct is a dcat:Dataset with dct:type restype:Dataproduct.
#   - New dataset fields: dct:isPartOf, dct:hasPart, dct:valid, stat:population.
#   - prov:wasGeneratedBy is indexed as nested activity (type, description).
#   - The dataset-only mandatory fields (identifier, contact point, keyword,
#     publisher, theme, access rights, rights, frequency, statistical unit,
#     language, modified, issued, temporal) moved from dzg:DatasetShape into
#     dzg:DatasetMandatoryValidationShape. They still apply to every dataset
#     that is not a dataproduct.
#   - Dataproduct rules: dzg:DataproductValidationShape.
#   - Member rules: at most one dct:isPartOf; members of a series use
#     dcat:inSeries only.
#   - dcat:inSeries no longer validates the series against
#     dzg:DatasetSeriesShape (the series is not in the dataset graph, every
#     dataset referencing its series by IRI failed); node kind is now sh:IRI.
#   - The class Dataproduct is mandatory: every dataset belongs to a
#     dataproduct (dct:isPartOf or dcat:inSeries), every series has exactly
#     one dct:isPartOf.
#   - Survey method: the description is optional and only allowed with
#     erh:andere.
# 1.1 (2026-11-24) Distribution (DZG user story "Klasse Distribution"):
#   - Every dataset that is not a dataproduct has at least one distribution.
#   - dcat:byteSize is mandatory, at most one value.
#   - dct:format: at most one value.
#   - dcatap:availability: at most one value from the EU planned-availability
#     vocabulary (TEMPORARY, EXPERIMENTAL, AVAILABLE, STABLE).
#   - (2026-11-27) Distribution name mandatory when the dataset has access
#     rights NON_PUBLIC ("Scientific Use Files"):
#     dzg:NonPublicDistributionRequiresTitle.
#   - (2026-11-27) At most one value (DCAT-AP 3.0.1 0..1) for checksum,
#     compressFormat, hasPolicy, mediaType, modified, packageFormat, issued,
#     spatialResolutionInMeters, status, temporalResolution.
# 1.1 (2026-11-24) Dataset series (DZG user story "Klasse Datensatzserie"):
#   - dct:accrualPeriodicity: at most one value (DCAT-AP 0..1) from the EU
#     frequency vocabulary; index mapping "Frequency" like on datasets.
#   - New dcatat:frequencyDescription (prefix dcatat: http://dcat-ap.at/ns#),
#     optional, only allowed with frequency OTHER.
#   - dct:temporal is validated with dzg:PeriodOfTimeShape.
#   - dct:publisher, dct:modified, dct:issued: at most one value (DCAT-AP 0..1).

dzg:Profile
    a pv:PiveauProfile ;
    pv:profileVersion "1.1" ;
    dct:title "DZG DCAT-AP 3.0.1 profile with AT adaptations"@en ;
    dct:description "DCAT-AP 3.0.1 field model with DCAT-AP AT 2.1 mandatory constraints."@en ;
    dct:conformsTo <https://www.w3.org/TR/vocab-dcat/> ,
    <https://www.dcat-ap.at/> .

dzg:AgentShape
  a sh:NodeShape ;
  sh:targetClass foaf:Agent ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path foaf:name ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "name"
  ], [
    sh:path foaf:homepage ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardDisabled" ;
    pv:mappingName "homepage"
  ], [
    sh:path foaf:mbox ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardDisabled" ;
    pv:mappingName "email"
  ], [
    sh:path vcard:hasAddress ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AddressShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "address" ;
    pv:mappingLink dzg:AddressShape
  ], [
    sh:path dct:type ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "type"
  ] .

dzg:ContactPointShape
  a sh:NodeShape ;
  sh:targetClass vcard:Kind ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path vcard:fn ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "name"
  ], [
    sh:path vcard:hasEmail ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "email"
  ], [
    sh:path vcard:hasURL ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardDisabled" ;
    pv:mappingName "url"
  ] .

dzg:CatalogShape
  a sh:NodeShape ;
  sh:targetClass dcat:Catalog ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLangTitle" ;
    pv:mappingName "title"
  ], [
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "description"
  ], [
    sh:path dct:publisher ;
    sh:minCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AgentShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "publisher" ;
    pv:mappingLink dzg:AgentShape
  ], [
    sh:path dct:language ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Language" ;
    pv:mappingName "language"
  ], [
    sh:path dcatap:applicableLegislation ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "applicable_legislation"
  ], [
    sh:path dct:license ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:LicenseShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "license" ;
    pv:mappingLink dzg:LicenseShape
  ], [
    sh:path dct:issued ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "issued"
  ], [
    sh:path dct:spatial ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Spatial" ;
    pv:mappingName "spatial"
  ], [
    sh:path dct:temporal ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:PeriodOfTimeShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateRange" ;
    pv:mappingName "temporal"
  ], [
    sh:path dct:hasPart ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "has_part"
  ], [
    sh:path dct:modified ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "modified"
  ], [
    sh:path dct:rights ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "rights"
  ], [
    sh:path dcat:themeTaxonomy ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "theme_taxonomy"
  ], [
    sh:path dcat:service ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:DataServiceShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "services" ;
    pv:mappingLink dzg:DataServiceShape
  ], [
    sh:path dcat:catalog ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "catalog"
  ], [
    sh:path dct:creator ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AgentShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Agent" ;
    pv:mappingName "creator"
  ], [
    sh:path foaf:homepage ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardDisabled" ;
    pv:mappingName "homepage"
  ], [
    sh:path dcat:record ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:CatalogRecordShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "records"
  ], [
    sh:path dcat:dataset ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "datasets"
  ] ;

  # Technical Piveau index fields; these pathless declarations are not validation rules.
  sh:property [
    sh:maxCount 1 ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "id"
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "resource"
  ], [
    # Spatial emits this field alongside the geometry field.
    pv:mappingClass "SpatialResource" ;
    pv:mappingName "spatial_resource"
  ] .

dzg:DatasetShape
  a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  sh:node dzg:DatasetLanguageValidationShape ;
  # Mandatory fields depend on dct:type (dataset vs. dataproduct), see below.
  sh:node dzg:DatasetMandatoryValidationShape ;
  sh:node dzg:DataproductValidationShape ;
  sh:node dzg:DatasetMembershipValidationShape ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLangTitle" ;
    pv:mappingName "title"
  ], [
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "description"
  ], [
    sh:path dct:identifier ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "identifier"
  ], [
    sh:path dcat:contactPoint ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:ContactPointShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "ContactPoint" ;
    pv:mappingName "contact_point"
  ], [
    sh:path dcat:keyword ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "Keywords" ;
    pv:mappingName "keywords"
  ], [
    sh:path dct:publisher ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AgentShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Agent" ;
    pv:mappingName "publisher"
  ], [
    sh:path dcat:theme ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Theme" ;
    pv:mappingName "categories"
  ], [
    sh:path dcatap:hvdCategory ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "hvd_category"
  ], [
    # The series is a record of its own; its triples are not in the dataset graph.
    sh:path dcat:inSeries ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "in_series"
  ], [
    sh:path dct:accessRights ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "AccessRight" ;
    pv:mappingName "access_right"
  ], [
    sh:path dct:rights ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "rights"
  ], [
    sh:path dcatap:applicableLegislation ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "applicable_legislation"
  ], [
    sh:path dct:conformsTo ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "conforms_to"
  ], [
    sh:path dct:creator ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AgentShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Agent" ;
    pv:mappingName "creator"
  ], [
    sh:path foaf:page ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Page" ;
    pv:mappingName "page"
  ], [
    sh:path dct:accrualPeriodicity ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Frequency" ;
    pv:mappingName "accrual_periodicity"
  ], [
    sh:path dct:spatial ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Spatial" ;
    pv:mappingName "spatial"
  ], [
    sh:path stat:statUnit ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "stat_unit"
  ], [
    sh:path dct:hasVersion ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "has_version"
  ], [
    sh:path dct:isReferencedBy ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "is_referenced_by"
  ], [
    sh:path dcat:landingPage ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Page" ;
    pv:mappingName "landing_page"
  ], [
    sh:path dct:language ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Language" ;
    pv:mappingName "language"
  ], [
    sh:path dct:modified ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "modified"
  ], [
    sh:path adms:identifier ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:IdentifierShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "AdmsIdentifier" ;
    pv:mappingName "adms_identifier"
  ], [
    sh:path dct:provenance ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "provenance"
  ], [
    sh:path prov:qualifiedAttribution ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AttributionShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "qualified_attribution"
  ], [
    sh:path dcat:qualifiedRelation ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:RelationshipShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "QualifiedRelation" ;
    pv:mappingName "qualified_relation"
  ], [
    sh:path dct:relation ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "relation"
  ], [
    sh:path dct:issued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "issued"
  ], [
    sh:path adms:sample ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "sample"
  ], [
    sh:path dct:source ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "source"
  ], [
    sh:path dcat:spatialResolutionInMeters ;
    sh:datatype xsd:decimal ;
    sh:severity sh:Violation ;
    pv:mappingClass "Integer" ;
    pv:mappingName "spatial_resolution_in_meters"
  ], [
    sh:path dct:temporal ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:PeriodOfTimeShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateRange" ;
    pv:mappingName "temporal"
  ], [
    sh:path dcat:temporalResolution ;
    sh:datatype xsd:duration ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "temporal_resolution"
  ], [
    sh:path dct:type ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "DatasetType" ;
    pv:mappingName "type"
  ], [
    sh:path dcat:version ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledText" ;
    pv:mappingName "version"
  ], [
    sh:path adms:versionNotes ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "version_notes"
  ], [
    sh:path prov:wasGeneratedBy ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:ActivityShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "was_generated_by" ;
    pv:mappingLink dzg:ActivityShape
  ], [
    # Dataproduct: the dataproduct this dataset belongs to (at most one).
    sh:path dct:isPartOf ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "is_part_of"
  ], [
    # Dataproduct: members (datasets, dataset series). Derived from dct:isPartOf on export.
    sh:path dct:hasPart ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "has_part"
  ], [
    # Dataproduct: validity period ("gueltig seit / gueltig bis").
    sh:path dct:valid ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:PeriodOfTimeShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateRange" ;
    pv:mappingName "valid"
  ], [
    # Statistical population ("Grundgesamtheit"), StatDCAT-AP proposal.
    sh:path stat:population ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "population"
  ], [
    sh:path dcat:distribution ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:DistributionShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "distributions" ;
    pv:mappingLink dzg:DistributionShape
  ], [
    sh:path dzg:working_contact ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AgentShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Agent" ;
    pv:mappingName "working_contact"
  ], [
    sh:path dzg:working_state ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:in (
      "in Bearbeitung"
      "formale Prüfung eingereicht"
      "verworfen"
      "Verbesserung notwendig"
      "formale Prüfung abgeschlossen"
    ) ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "working_state"
  ], [
    sh:path dcat:working_state_modified ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "working_state_modified"
  ] ;

  # Technical Piveau index fields; these pathless declarations are not validation rules.
  sh:property [
    sh:maxCount 1 ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "id"
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "resource"
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "Nested" ;
    pv:mappingName "catalog" ;
    pv:mappingProperty [
      sh:minCount 1 ;
      sh:maxCount 1 ;
      pv:mappingClass "StandardText" ;
      pv:mappingName "id"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "StandardResourceKeyword" ;
      pv:mappingName "is_part_of"
    ]
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "Nested" ;
    pv:mappingName "catalog_record" ;
    pv:mappingProperty [
      sh:maxCount 1 ;
      pv:mappingClass "DateTime" ;
      pv:mappingName "issued"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "DateTime" ;
      pv:mappingName "modified"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "StandardText" ;
      pv:mappingName "access_level"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "StandardKeyword" ;
      pv:mappingName "publication_status"
    ]
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "Metrics" ;
    pv:mappingName "quality_meas"
  ], [
    # Spatial emits this field alongside the geometry field.
    pv:mappingClass "SpatialResource" ;
    pv:mappingName "spatial_resource"
  ] .

dzg:DatasetSeriesShape
  a sh:NodeShape ;
  sh:targetClass dcat:DatasetSeries ;
  sh:node dzg:DatasetSeriesMembershipValidationShape ;
  sh:node dzg:DatasetSeriesFrequencyValidationShape ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLangTitle" ;
    pv:mappingName "title"
  ], [
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "description"
  ], [
    sh:path dcat:contactPoint ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:ContactPointShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "ContactPoint" ;
    pv:mappingName "contact_point"
  ], [
    sh:path dct:spatial ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Spatial" ;
    pv:mappingName "spatial"
  ], [
    sh:path dct:publisher ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:AgentShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Agent" ;
    pv:mappingName "publisher"
  ], [
    sh:path dcatap:applicableLegislation ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "applicable_legislation"
  ], [
    # Frequency of the series (DCAT-AP 3.0.1: 0..1), EU frequency vocabulary.
    sh:path dct:accrualPeriodicity ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://publications\\.europa\\.eu/resource/authority/frequency/" ;
    sh:severity sh:Violation ;
    pv:mappingClass "Frequency" ;
    pv:mappingName "accrual_periodicity"
  ], [
    # Description of the frequency when it is "other" (frequency/OTHER).
    sh:path dcatat:frequencyDescription ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "frequency_description"
  ], [
    sh:path dct:modified ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "modified"
  ], [
    sh:path dct:issued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "issued"
  ], [
    # Period or point in time ("Zeitraum/Zeitpunkt"); a point has startDate = endDate.
    sh:path dct:temporal ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:PeriodOfTimeShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateRange" ;
    pv:mappingName "temporal"
  ], [
    # Dataproduct the series belongs to (exactly one, the class Dataproduct is mandatory).
    sh:path dct:isPartOf ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "is_part_of"
  ] ;

  # Technical Piveau index fields; these pathless declarations are not validation rules.
  sh:property [
    sh:maxCount 1 ;
    pv:mappingClass "StandardText" ;
    pv:mappingName "id"
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "resource"
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "Nested" ;
    pv:mappingName "catalog" ;
    pv:mappingProperty [
      sh:minCount 1 ;
      sh:maxCount 1 ;
      pv:mappingClass "StandardText" ;
      pv:mappingName "id"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "StandardResourceKeyword" ;
      pv:mappingName "is_part_of"
    ]
  ], [
    sh:maxCount 1 ;
    pv:mappingClass "Nested" ;
    pv:mappingName "catalog_record" ;
    pv:mappingProperty [
      sh:maxCount 1 ;
      pv:mappingClass "DateTime" ;
      pv:mappingName "issued"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "DateTime" ;
      pv:mappingName "modified"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "StandardText" ;
      pv:mappingName "access_level"
    ], [
      sh:maxCount 1 ;
      pv:mappingClass "StandardKeyword" ;
      pv:mappingName "publication_status"
    ]
  ], [
    # Spatial emits this field alongside the geometry field.
    pv:mappingClass "SpatialResource" ;
    pv:mappingName "spatial_resource"
  ] .

dzg:DistributionShape
  a sh:NodeShape ;
  sh:targetClass dcat:Distribution ;

  # Metadata fields and their index mappings.
  sh:property [
    sh:path dcat:accessURL ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardDisabled" ;
    pv:mappingName "access_url"
  ], [
    sh:path dct:format ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Format" ;
    pv:mappingName "format"
  ], [
    sh:path dct:license ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "license"
  ], [
    sh:path dcat:accessService ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:DataServiceShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Nested" ;
    pv:mappingName "access_service" ;
    pv:mappingLink dzg:DataServiceShape
  ], [
    sh:path dct:conformsTo ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "conforms_to"
  ], [
    sh:path dct:issued ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "issued"
  ], [
    sh:path dct:language ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Language" ;
    pv:mappingName "language"
  ], [
    sh:path dct:modified ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "DateTime" ;
    pv:mappingName "modified"
  ], [
    sh:path dct:rights ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "rights"
  ], [
    sh:path dct:title ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "TrimmedMultiLangSubtitle" ;
    pv:mappingName "title"
  ], [
    sh:path spdx:checksum ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:ChecksumShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "Checksum" ;
    pv:mappingName "checksum"
  ], [
    sh:path adms:status ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "AdmsSkos" ;
    pv:mappingName "status"
  ], [
    # DZG user story: mandatory, one value (may be estimated).
    sh:path dcat:byteSize ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:nonNegativeInteger ;
    sh:severity sh:Violation ;
    pv:mappingClass "Integer" ;
    pv:mappingName "byte_size"
  ], [
    sh:path dcat:downloadURL ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardDisabled" ;
    pv:mappingName "download_url"
  ], [
    sh:path dcat:mediaType ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "MediaType" ;
    pv:mappingName "media_type"
  ], [
    sh:path foaf:page ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Page" ;
    pv:mappingName "page"
  ], [
    sh:path odrl:hasPolicy ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node dzg:PolicyShape ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "has_policy"
  ], [
    sh:path dcat:compressFormat ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Document" ;
    pv:mappingName "compress_format"
  ], [
    sh:path dcat:packageFormat ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "Document" ;
    pv:mappingName "package_format"
  ], [
    sh:path dcat:temporalResolution ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardKeyword" ;
    pv:mappingName "temporal_resolution"
  ], [
    sh:path dcat:spatialResolutionInMeters ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:severity sh:Violation ;
    pv:mappingClass "Integer" ;
    pv:mappingName "spatial_resolution_in_meters"
  ], [
    sh:path dct:description ;
    sh:nodeKind sh:Literal ;
    sh:severity sh:Violation ;
    pv:mappingClass "SimpleMultiLang" ;
    pv:mappingName "description"
  ], [
    sh:path dcatap:availability ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <http://publications.europa.eu/resource/authority/planned-availability/TEMPORARY>
      <http://publications.europa.eu/resource/authority/planned-availability/EXPERIMENTAL>
      <http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE>
      <http://publications.europa.eu/resource/authority/planned-availability/STABLE>
    ) ;
    sh:severity sh:Violation ;
    pv:mappingClass "LabeledResource" ;
    pv:mappingName "availability"
  ], [
    sh:path dct:type ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "DistributionType" ;
    pv:mappingName "type"
  ], [
    sh:path dcatap:applicableLegislation ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    pv:mappingClass "StandardResourceKeyword" ;
    pv:mappingName "applicable_legislation"
  ] .

