{
  "standard": "dcat-ap-3",
  "version": "3.0",
  "groups": [
    {
      "id": "basic",
      "label": { "de": "Grundinformationen", "en": "Basic Information" },
      "fields": ["dct:title", "dct:description", "dct:identifier", "dcat:version"]
    },
    {
      "id": "temporal",
      "label": { "de": "Zeitangaben", "en": "Temporal Information" },
      "fields": ["dct:issued", "dct:modified", "dct:accrualPeriodicity"]
    },
    {
      "id": "responsible",
      "label": { "de": "Verantwortliche", "en": "Responsible Parties" },
      "fields": ["dct:publisher", "dcat:contactPoint"]
    },
    {
      "id": "classification",
      "label": { "de": "Klassifizierung", "en": "Classification" },
      "fields": ["dcat:theme", "dcat:keyword", "dct:language"]
    },
    {
      "id": "coverage",
      "label": { "de": "Abdeckung", "en": "Coverage" },
      "fields": ["dct:spatial", "dct:temporal"]
    },
    {
      "id": "legal",
      "label": { "de": "Rechtliches", "en": "Legal" },
      "fields": ["dct:license", "odrl:hasPolicy"]
    },
    {
      "id": "relations",
      "label": { "de": "Beziehungen", "en": "Relations" },
      "fields": ["dcat:qualifiedRelation", "dcat:distribution"]
    }
  ],
  "fields": {
    "dct:title": {
      "label": { "de": "Titel", "en": "Title" },
      "placeholder": { "de": "Titel des Datensatzes", "en": "Dataset title" },
      "errorMessages": {
        "required": { "de": "Titel ist erforderlich", "en": "Title is required" }
      },
      "order": 1
    },
    "dct:description": {
      "label": { "de": "Beschreibung", "en": "Description" },
      "placeholder": { "de": "Kurze Beschreibung des Inhalts", "en": "Brief description of the content" },
      "errorMessages": {
        "required": { "de": "Beschreibung ist erforderlich", "en": "Description is required" }
      },
      "order": 2
    },
    "dct:identifier": {
      "label": { "de": "Identifikator", "en": "Identifier" },
      "placeholder": { "de": "https://...", "en": "https://..." },
      "order": 3
    },
    "dcat:version": {
      "label": { "de": "Version", "en": "Version" },
      "placeholder": { "de": "1.0.0", "en": "1.0.0" },
      "hint": { "de": "Versionsnummer des Datensatzes", "en": "Version number of the dataset" },
      "order": 4
    },
    "dct:issued": {
      "label": { "de": "Veröffentlichungsdatum", "en": "Issued Date" },
      "order": 5
    },
    "dct:modified": {
      "label": { "de": "Zuletzt geändert", "en": "Last Modified" },
      "order": 6
    },
    "dct:accrualPeriodicity": {
      "label": { "de": "Aktualisierungsfrequenz", "en": "Update Frequency" },
      "options": [
        { "value": "http://publications.europa.eu/resource/authority/frequency/DAILY", "label": { "de": "Täglich", "en": "Daily" } },
        { "value": "http://publications.europa.eu/resource/authority/frequency/WEEKLY", "label": { "de": "Wöchentlich", "en": "Weekly" } },
        { "value": "http://publications.europa.eu/resource/authority/frequency/MONTHLY", "label": { "de": "Monatlich", "en": "Monthly" } },
        { "value": "http://publications.europa.eu/resource/authority/frequency/QUARTERLY", "label": { "de": "Vierteljährlich", "en": "Quarterly" } },
        { "value": "http://publications.europa.eu/resource/authority/frequency/ANNUAL", "label": { "de": "Jährlich", "en": "Annual" } },
        { "value": "http://publications.europa.eu/resource/authority/frequency/IRREG", "label": { "de": "Unregelmäßig", "en": "Irregular" } }
      ],
      "order": 7
    },
    "dct:publisher": {
      "label": { "de": "Herausgeber (URI)", "en": "Publisher (URI)" },
      "placeholder": { "de": "https://www.example.org/", "en": "https://www.example.org/" },
      "errorMessages": {
        "required": { "de": "Herausgeber ist erforderlich", "en": "Publisher is required" }
      },
      "order": 8
    },
    "dcat:contactPoint": {
      "label": { "de": "Kontaktstelle (URI)", "en": "Contact Point (URI)" },
      "placeholder": { "de": "https://www.example.org/contact", "en": "https://www.example.org/contact" },
      "order": 9
    },
    "dcat:theme": {
      "label": { "de": "Thema", "en": "Theme" },
      "options": [
        { "value": "http://publications.europa.eu/resource/authority/data-theme/AGRI", "label": { "de": "Landwirtschaft", "en": "Agriculture" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/ECON", "label": { "de": "Wirtschaft", "en": "Economy" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/EDUC", "label": { "de": "Bildung", "en": "Education" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/ENVI", "label": { "de": "Umwelt", "en": "Environment" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/GOVE", "label": { "de": "Verwaltung", "en": "Government" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/HEAL", "label": { "de": "Gesundheit", "en": "Health" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/SOCI", "label": { "de": "Gesellschaft", "en": "Society" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/TECH", "label": { "de": "Wissenschaft und Technologie", "en": "Science and Technology" } },
        { "value": "http://publications.europa.eu/resource/authority/data-theme/TRAN", "label": { "de": "Transport", "en": "Transport" } }
      ],
      "errorMessages": {
        "required": { "de": "Thema ist erforderlich", "en": "Theme is required" }
      },
      "order": 10
    },
    "dcat:keyword": {
      "label": { "de": "Schlagwörter", "en": "Keywords" },
      "placeholder": { "de": "Schlagwort eingeben...", "en": "Enter keyword..." },
      "order": 11
    },
    "dct:language": {
      "label": { "de": "Sprache", "en": "Language" },
      "options": [
        { "value": "http://publications.europa.eu/resource/authority/language/DEU", "label": { "de": "Deutsch", "en": "German" } },
        { "value": "http://publications.europa.eu/resource/authority/language/ENG", "label": { "de": "Englisch", "en": "English" } },
        { "value": "http://publications.europa.eu/resource/authority/language/FRA", "label": { "de": "Französisch", "en": "French" } }
      ],
      "order": 12
    },
    "dct:spatial": {
      "label": { "de": "Räumliche Abdeckung (URI)", "en": "Spatial Coverage (URI)" },
      "placeholder": { "de": "https://sws.geonames.org/...", "en": "https://sws.geonames.org/..." },
      "order": 13
    },
    "dct:temporal": {
      "label": { "de": "Zeitliche Abdeckung (URI)", "en": "Temporal Coverage (URI)" },
      "order": 14
    },
    "dct:license": {
      "label": { "de": "Lizenz (URI)", "en": "License (URI)" },
      "placeholder": { "de": "https://creativecommons.org/licenses/by/4.0/", "en": "https://creativecommons.org/licenses/by/4.0/" },
      "order": 15
    },
    "odrl:hasPolicy": {
      "label": { "de": "Nutzungsrichtlinie (URI)", "en": "Usage Policy (URI)" },
      "placeholder": { "de": "https://...", "en": "https://..." },
      "hint": { "de": "ODRL Policy URI", "en": "ODRL Policy URI" },
      "order": 16
    },
    "dcat:qualifiedRelation": {
      "label": { "de": "Qualifizierte Beziehung (URI)", "en": "Qualified Relation (URI)" },
      "order": 17
    },
    "dcat:distribution": {
      "label": { "de": "Distribution (URI)", "en": "Distribution (URI)" },
      "placeholder": { "de": "https://...", "en": "https://..." },
      "order": 18
    }
  }
}
