{
  "standard": "geodcat",
  "version": "2.0",
  "groups": [
    {
      "id": "basic",
      "label": { "de": "Grundinformationen", "en": "Basic Information" },
      "fields": ["dct:title", "dct:description", "dct:identifier"]
    },
    {
      "id": "geographic",
      "label": { "de": "Geografische Informationen", "en": "Geographic Information" },
      "fields": ["dct:spatial", "geo:hasGeometry", "locn:geometry"]
    },
    {
      "id": "dates",
      "label": { "de": "Datumsangaben", "en": "Dates" },
      "fields": ["dct:issued", "dct:modified", "dct:temporal"]
    },
    {
      "id": "contact",
      "label": { "de": "Kontakt & Herausgeber", "en": "Contact & Publisher" },
      "fields": ["dct:publisher", "dcat:contactPoint", "dct:language"]
    },
    {
      "id": "provenance",
      "label": { "de": "Herkunft & Konformität", "en": "Provenance & Conformance" },
      "fields": ["dct:conformsTo", "dct:source"]
    }
  ],
  "fields": {
    "dct:title": {
      "type": "langstring",
      "required": true,
      "label": { "de": "Titel", "en": "Title" },
      "placeholder": { "de": "Titel des Geodatensatzes", "en": "Title of the geodataset" },
      "errorMessages": {
        "required": { "de": "Titel ist erforderlich", "en": "Title is required" }
      },
      "defaultValue": { "de": "", "en": "" },
      "order": 1,
      "visible": true
    },
    "dct:description": {
      "type": "textarea",
      "required": true,
      "label": { "de": "Beschreibung", "en": "Description" },
      "errorMessages": {
        "required": { "de": "Beschreibung ist erforderlich", "en": "Description is required" }
      },
      "order": 2,
      "visible": true
    },
    "dct:identifier": {
      "type": "uri",
      "required": true,
      "validate": "isURI",
      "label": { "de": "Identifikator", "en": "Identifier" },
      "errorMessages": {
        "required": { "de": "Identifikator ist erforderlich", "en": "Identifier is required" }
      },
      "order": 3,
      "visible": true
    },
    "dct:spatial": {
      "type": "uri",
      "validate": "isURI",
      "label": { "de": "Räumliche Abdeckung", "en": "Spatial Coverage" },
      "hint": { "de": "URI einer geografischen Region (z.B. Geonames)", "en": "URI of a geographic region (e.g. Geonames)" },
      "order": 4,
      "visible": true
    },
    "geo:hasGeometry": {
      "type": "uri",
      "validate": "isURI",
      "label": { "de": "GeoSPARQL Geometrie", "en": "GeoSPARQL Geometry" },
      "placeholder": { "de": "URI der Geometrie", "en": "URI of geometry" },
      "order": 5,
      "visible": true
    },
    "locn:geometry": {
      "type": "textarea",
      "validate": "isWKTorGeoJSON",
      "label": { "de": "WKT/GeoJSON Geometrie", "en": "WKT/GeoJSON Geometry" },
      "placeholder": { "de": "POLYGON((...))", "en": "POLYGON(())" },
      "order": 6,
      "visible": true
    },
    "dct:issued": {
      "type": "date",
      "label": { "de": "Veröffentlichungsdatum", "en": "Publication Date" },
      "order": 7,
      "visible": true
    },
    "dct:modified": {
      "type": "date",
      "label": { "de": "Änderungsdatum", "en": "Modification Date" },
      "order": 8,
      "visible": true
    },
    "dct:temporal": {
      "type": "text",
      "label": { "de": "Zeitliche Abdeckung", "en": "Temporal Coverage" },
      "order": 9,
      "visible": true
    },
    "dct:publisher": {
      "type": "object",
      "multiple": false,
      "required": true,
      "label": { "de": "Herausgeber", "en": "Publisher" },
      "errorMessages": {
        "required": { "de": "Herausgeber ist erforderlich", "en": "Publisher is required" }
      },
      "order": 10,
      "visible": true,
      "subFields": [
        { "id": "foaf:name", "type": "text", "required": true, "label": { "de": "Name", "en": "Name" } },
        { "id": "foaf:homepage", "type": "uri", "validate": "isURI", "label": { "de": "Webseite", "en": "Homepage" } },
        { "id": "dct:type", "type": "select", "label": { "de": "Typ", "en": "Type" },
          "options": [
            { "value": "http://purl.org/adms/publishertype/LocalAuthority", "label": { "de": "Lokale Behörde", "en": "Local Authority" } },
            { "value": "http://purl.org/adms/publishertype/NationalAuthority", "label": { "de": "Nationale Behörde", "en": "National Authority" } },
            { "value": "http://purl.org/adms/publishertype/Company", "label": { "de": "Unternehmen", "en": "Company" } },
            { "value": "http://purl.org/adms/publishertype/Academia", "label": { "de": "Forschungseinrichtung", "en": "Academia/Scientific organisation" } }
          ]
        }
      ]
    },
    "dcat:contactPoint": {
      "type": "object",
      "multiple": false,
      "label": { "de": "Kontaktpunkt", "en": "Contact Point" },
      "order": 11,
      "visible": true,
      "subFields": [
        { "id": "vcard:fn", "type": "text", "required": true, "label": { "de": "Name", "en": "Name" } },
        { "id": "vcard:hasEmail", "type": "text", "validate": "isEmail", "label": { "de": "E-Mail", "en": "Email" } },
        { "id": "vcard:hasTelephone", "type": "text", "label": { "de": "Telefon", "en": "Telephone" } },
        { "id": "vcard:hasURL", "type": "uri", "validate": "isURI", "label": { "de": "Webseite", "en": "Website" } }
      ]
    },
    "dct:language": {
      "type": "uri",
      "validate": "isURI",
      "label": { "de": "Sprache", "en": "Language" },
      "placeholder": { "de": "http://publications.europa.eu/resource/authority/language/DEU", "en": "http://publications.europa.eu/resource/authority/language/ENG" },
      "defaultValue": "http://publications.europa.eu/resource/authority/language/DEU",
      "order": 12,
      "visible": true
    },
    "dct:conformsTo": {
      "type": "uri",
      "validate": "isURI",
      "label": { "de": "Konformität", "en": "Conforms To" },
      "placeholder": { "de": "URI der Spezifikation", "en": "URI of specification" },
      "order": 13,
      "visible": true
    },
    "dct:source": {
      "type": "uri",
      "validate": "isURI",
      "label": { "de": "Quelldatensatz", "en": "Source Dataset" },
      "placeholder": { "de": "URI des Quelldatensatzes", "en": "URI of source dataset" },
      "order": 14,
      "visible": true
    }
  }
}
