{
  "standard": "dcat-ap-at",
  "version": "2.1",
  "rootClass": "dcat:Dataset",
  "wizard": true,
  "groups": [
    {
      "id": "basic",
      "label": {
        "de": "Grundinformationen",
        "en": "Basic Information"
      },
      "fields": [
        "dct:title",
        "dct:description",
        "dct:identifier",
        "dct:type"
      ]
    },
    {
      "id": "classification",
      "label": {
        "de": "Klassifizierung",
        "en": "Classification"
      },
      "fields": [
        "dcat:theme",
        "dcat:keyword",
        "dct:language",
        "dct:accessRights"
      ]
    },
    {
      "id": "dates",
      "label": {
        "de": "Zeitangaben",
        "en": "Dates & Frequency"
      },
      "fields": [
        "dct:issued",
        "dct:modified",
        "dct:accrualPeriodicity"
      ]
    },
    {
      "id": "coverage",
      "label": {
        "de": "Abdeckung",
        "en": "Coverage"
      },
      "fields": [
        "dct:spatial",
        "dct:temporal"
      ]
    },
    {
      "id": "contact",
      "label": {
        "de": "Kontakt & Herausgeber",
        "en": "Contact & Publisher"
      },
      "fields": [
        "dct:publisher",
        "dcat:contactPoint"
      ]
    },
    {
      "id": "access",
      "label": {
        "de": "Zugang & Rechtliches",
        "en": "Access & Legal"
      },
      "fields": [
        "dcatap:availability",
        "dcat:landingPage",
        "dcatap:applicableLegislation",
        "dcatap:hvdCategory"
      ]
    },
    {
      "id": "distributions",
      "label": {
        "de": "Distributionen",
        "en": "Distributions"
      },
      "fields": [
        "dcat:distribution"
      ]
    }
  ],
  "fields": {
    "dct:title": {
      "type": "langstring",
      "required": true,
      "label": {
        "de": "Titel",
        "en": "Title"
      },
      "placeholder": {
        "de": "Titel des Datensatzes",
        "en": "Dataset title"
      },
      "errorMessages": {
        "required": {
          "de": "Titel ist erforderlich",
          "en": "Title is required"
        }
      },
      "defaultValue": {
        "de": "",
        "en": ""
      },
      "order": 1,
      "visible": true
    },
    "dct:description": {
      "type": "textarea",
      "required": true,
      "label": {
        "de": "Beschreibung",
        "en": "Description"
      },
      "placeholder": {
        "de": "Beschreibung des Datensatzes, seines Inhalts und Verwendungszwecks …",
        "en": "Description of the dataset, its content and intended use …"
      },
      "errorMessages": {
        "required": {
          "de": "Beschreibung ist erforderlich",
          "en": "Description is required"
        }
      },
      "order": 2,
      "visible": true
    },
    "dct:identifier": {
      "type": "text",
      "required": true,
      "validate": "isURI",
      "transform": "uriSuffix",
      "transformOptions": {
        "prefix": "https://data.gv.at/dataset/"
      },
      "generate": "uuid",
      "generateOptions": {
        "prefix": "https://data.gv.at/dataset/"
      },
      "label": {
        "de": "Datensatz-ID",
        "en": "Dataset ID"
      },
      "hint": {
        "de": "Eindeutige URI des Datensatzes",
        "en": "Unique URI of the dataset"
      },
      "placeholder": {
        "de": "z.B. mein-datensatz-2024",
        "en": "e.g. my-dataset-2024"
      },
      "errorMessages": {
        "required": {
          "de": "Identifikator ist erforderlich",
          "en": "Identifier is required"
        },
        "isURI": {
          "de": "Kein gültiger URI",
          "en": "Not a valid URI"
        }
      },
      "order": 3,
      "visible": true
    },
    "dct:type": {
      "type": "select",
      "label": {
        "de": "Datensatztyp",
        "en": "Dataset Type"
      },
      "hint": {
        "de": "Art des Datensatzes",
        "en": "Type of the dataset"
      },
      "optionsSource": "/vocabularies/dataset-type.json",
      "order": 4,
      "visible": true
    },
    "dcat:theme": {
      "type": "multiselect",
      "label": {
        "de": "Thema",
        "en": "Theme"
      },
      "hint": {
        "de": "Thematische Kategorie(n) des Datensatzes",
        "en": "Thematic category or categories of the dataset"
      },
      "optionsSource": "/vocabularies/data-theme.json",
      "order": 5,
      "visible": true
    },
    "dcat:keyword": {
      "type": "langstring",
      "multiple": true,
      "label": {
        "de": "Schlagwörter",
        "en": "Keywords"
      },
      "placeholder": {
        "de": "Schlagwort eingeben",
        "en": "Enter keyword"
      },
      "order": 6,
      "visible": true
    },
    "dct:language": {
      "type": "searchselect",
      "multiple": false,
      "label": {
        "de": "Sprache",
        "en": "Language"
      },
      "hint": {
        "de": "Sprache des Datensatzes",
        "en": "Language of the dataset content"
      },
      "optionsSource": "https://publications.europa.eu/resource/authority/language.json",
      "optionsSourceFallback": "/vocabularies/language.json",
      "defaultValue": "http://publications.europa.eu/resource/authority/language/DEU",
      "order": 7,
      "visible": true
    },
    "dct:accessRights": {
      "type": "select",
      "label": {
        "de": "Zugangsbeschränkung",
        "en": "Access Rights"
      },
      "hint": {
        "de": "Gibt an, ob der Datensatz öffentlich zugänglich ist",
        "en": "Indicates whether the dataset is publicly accessible"
      },
      "optionsSource": "/vocabularies/access-right.json",
      "defaultValue": "http://publications.europa.eu/resource/authority/access-right/PUBLIC",
      "order": 8,
      "visible": true
    },
    "dct:issued": {
      "type": "date",
      "label": {
        "de": "Veröffentlichungsdatum",
        "en": "Publication Date"
      },
      "hint": {
        "de": "Datum der Erstveröffentlichung",
        "en": "Date of first publication"
      },
      "order": 9,
      "visible": true
    },
    "dct:modified": {
      "type": "date",
      "compute": "setTodayIfTitleAndEmpty",
      "label": {
        "de": "Zuletzt geändert",
        "en": "Last Modified"
      },
      "hint": {
        "de": "Datum der letzten Änderung",
        "en": "Date of last modification"
      },
      "order": 10,
      "visible": true
    },
    "dct:accrualPeriodicity": {
      "type": "select",
      "label": {
        "de": "Aktualisierungsfrequenz",
        "en": "Update Frequency"
      },
      "hint": {
        "de": "Wie oft wird der Datensatz aktualisiert?",
        "en": "How often is the dataset updated?"
      },
      "optionsSource": "/vocabularies/frequency.json",
      "order": 11,
      "visible": true
    },
    "dct:spatial": {
      "type": "object",
      "rdfType": "dct:Location",
      "label": {
        "de": "Räumliche Abdeckung",
        "en": "Spatial Coverage"
      },
      "hint": {
        "de": "Geografische Region als Bounding Box oder Geometrie",
        "en": "Geographic region as bounding box or geometry"
      },
      "order": 12,
      "visible": true,
      "subFields": [
        {
          "id": "dcat:bbox",
          "type": "map",
          "label": {
            "de": "Bounding Box",
            "en": "Bounding Box"
          },
          "hint": {
            "de": "Rechteck oder Polygon auf der Karte zeichnen",
            "en": "Draw a rectangle or polygon on the map"
          }
        },
        {
          "id": "locn:geometry",
          "type": "map",
          "label": {
            "de": "Geometrie",
            "en": "Geometry"
          },
          "hint": {
            "de": "Detaillierte Geometrie (Polygon)",
            "en": "Detailed geometry (polygon)"
          }
        }
      ]
    },
    "dct:temporal": {
      "type": "object",
      "label": {
        "de": "Zeitliche Abdeckung",
        "en": "Temporal Coverage"
      },
      "order": 13,
      "rdfType": "dct:PeriodOfTime",
      "subFields": [
        {
          "id": "dcat:startDate",
          "type": "date",
          "label": {
            "de": "Von",
            "en": "Start date"
          }
        },
        {
          "id": "dcat:endDate",
          "type": "date",
          "label": {
            "de": "Bis",
            "en": "End date"
          }
        }
      ]
    },
    "dct:publisher": {
      "type": "object",
      "multiple": false,
      "label": {
        "de": "Herausgeber",
        "en": "Publisher"
      },
      "hint": {
        "de": "Organisation oder Person, die den Datensatz veröffentlicht",
        "en": "Organisation or person publishing the dataset"
      },
      "order": 14,
      "visible": true,
      "subFields": [
        {
          "id": "foaf:name",
          "type": "text",
          "required": true,
          "label": {
            "de": "Name",
            "en": "Name"
          },
          "placeholder": {
            "de": "z.B. Stadt Wien",
            "en": "e.g. City of Vienna"
          }
        },
        {
          "id": "foaf:homepage",
          "type": "uri",
          "validate": "isURI",
          "label": {
            "de": "Webseite",
            "en": "Homepage"
          },
          "placeholder": {
            "de": "https://…",
            "en": "https://…"
          }
        },
        {
          "id": "foaf:mbox",
          "type": "text",
          "validate": "isEmail",
          "label": {
            "de": "E-Mail",
            "en": "Email"
          },
          "placeholder": {
            "de": "kontakt@beispiel.at",
            "en": "contact@example.at"
          }
        },
        {
          "id": "dct:type",
          "type": "select",
          "label": {
            "de": "Typ",
            "en": "Type"
          },
          "options": [
            {
              "value": "http://purl.org/adms/publishertype/LocalAuthority",
              "label": {
                "de": "Lokale Behörde",
                "en": "Local Authority"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/NationalAuthority",
              "label": {
                "de": "Nationale Behörde",
                "en": "National Authority"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/RegionalAuthority",
              "label": {
                "de": "Regionale Behörde",
                "en": "Regional Authority"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/Company",
              "label": {
                "de": "Unternehmen",
                "en": "Company"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/Academia",
              "label": {
                "de": "Forschungseinrichtung",
                "en": "Academia/Scientific organisation"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/NonProfitOrganisation",
              "label": {
                "de": "Non-Profit-Organisation",
                "en": "Non-Profit Organisation"
              }
            }
          ]
        }
      ],
      "remember": true,
      "suggestionsFrom": [
        "dcat:contactPoint"
      ],
      "suggestionsMap": {
        "vcard:fn": "foaf:name",
        "vcard:hasEmail": "foaf:mbox",
        "vcard:hasURL": "foaf:homepage"
      }
    },
    "dcat:contactPoint": {
      "type": "object",
      "multiple": false,
      "label": {
        "de": "Kontaktstelle",
        "en": "Contact Point"
      },
      "hint": {
        "de": "Ansprechperson oder -stelle für Rückfragen zum Datensatz",
        "en": "Person or team to contact about this dataset"
      },
      "order": 15,
      "visible": true,
      "subFields": [
        {
          "id": "vcard:fn",
          "type": "text",
          "required": true,
          "label": {
            "de": "Name",
            "en": "Name"
          },
          "placeholder": {
            "de": "Vor- und Nachname oder Teambezeichnung",
            "en": "Full name or team name"
          }
        },
        {
          "id": "vcard:hasEmail",
          "type": "text",
          "validate": "isEmail",
          "label": {
            "de": "E-Mail",
            "en": "Email"
          },
          "placeholder": {
            "de": "opendata@beispiel.at",
            "en": "opendata@example.at"
          }
        },
        {
          "id": "vcard:hasTelephone",
          "type": "text",
          "label": {
            "de": "Telefon",
            "en": "Telephone"
          },
          "placeholder": {
            "de": "+43 1 …",
            "en": "+43 1 …"
          }
        },
        {
          "id": "vcard:hasURL",
          "type": "uri",
          "validate": "isURI",
          "label": {
            "de": "Webseite",
            "en": "Website"
          },
          "placeholder": {
            "de": "https://…",
            "en": "https://…"
          }
        }
      ],
      "remember": true,
      "suggestionsFrom": [
        "dct:publisher"
      ],
      "suggestionsMap": {
        "foaf:name": "vcard:fn",
        "foaf:mbox": "vcard:hasEmail",
        "foaf:homepage": "vcard:hasURL"
      }
    },
    "dcatap:availability": {
      "type": "select",
      "label": {
        "de": "Verfügbarkeit",
        "en": "Availability"
      },
      "hint": {
        "de": "Wie lange wird dieser Datensatz verfügbar bleiben?",
        "en": "How long will this dataset remain available?"
      },
      "optionsSource": "/vocabularies/availability.json",
      "defaultValue": "http://data.europa.eu/r5r/availability/stable",
      "order": 16,
      "visible": true
    },
    "dcat:landingPage": {
      "type": "uri",
      "validate": "isURI",
      "multiple": false,
      "label": {
        "de": "Webseite zum Datensatz",
        "en": "Landing Page"
      },
      "hint": {
        "de": "URL der Datensatz-Seite im Webauftritt des Herausgebers",
        "en": "URL of the dataset page on the publisher's website"
      },
      "placeholder": {
        "de": "https://…",
        "en": "https://…"
      },
      "order": 17,
      "visible": true
    },
    "dcatap:applicableLegislation": {
      "type": "select",
      "label": {
        "de": "Rechtsgrundlage",
        "en": "Applicable Legislation"
      },
      "hint": {
        "de": "Rechtsvorschrift, die die Veröffentlichung vorschreibt (HVD-Verordnung aktiviert die HVD-Kategorie)",
        "en": "Legislation mandating publication (selecting the HVD regulation unlocks the HVD category field)"
      },
      "options": [
        {
          "value": "http://data.europa.eu/eli/reg_impl/2023/138/oj",
          "label": {
            "de": "EU-Durchführungsverordnung zu HVD (2023/138)",
            "en": "EU HVD Implementing Regulation (2023/138)"
          }
        },
        {
          "value": "http://data.europa.eu/eli/dir/2019/1024/oj",
          "label": {
            "de": "EU Open-Data-Richtlinie (2019/1024)",
            "en": "EU Open Data Directive (2019/1024)"
          }
        },
        {
          "value": "http://data.europa.eu/eli/dir/2007/2/oj",
          "label": {
            "de": "INSPIRE-Richtlinie (2007/2)",
            "en": "INSPIRE Directive (2007/2)"
          }
        }
      ],
      "order": 18,
      "visible": true
    },
    "dcatap:hvdCategory": {
      "type": "select",
      "label": {
        "de": "HVD-Kategorie",
        "en": "HVD Category"
      },
      "hint": {
        "de": "Kategorie als High-Value Dataset (HVD) gemäß EU-Durchführungsverordnung",
        "en": "High-value dataset category under the EU Implementing Regulation"
      },
      "options": [
        {
          "value": "http://data.europa.eu/bna/c_164e0bf5",
          "label": {
            "de": "Georaum",
            "en": "Geospatial"
          }
        },
        {
          "value": "http://data.europa.eu/bna/c_a9135398",
          "label": {
            "de": "Erdbeobachtung und Umwelt",
            "en": "Earth observation and environment"
          }
        },
        {
          "value": "http://data.europa.eu/bna/c_dd313021",
          "label": {
            "de": "Meteorologie",
            "en": "Meteorological"
          }
        },
        {
          "value": "http://data.europa.eu/bna/c_b6d8765e",
          "label": {
            "de": "Statistik",
            "en": "Statistics"
          }
        },
        {
          "value": "http://data.europa.eu/bna/c_7afce8d0",
          "label": {
            "de": "Unternehmen und Eigentümerschaft",
            "en": "Companies and company ownership"
          }
        },
        {
          "value": "http://data.europa.eu/bna/c_ac64a52d",
          "label": {
            "de": "Mobilität",
            "en": "Mobility"
          }
        }
      ],
      "order": 19,
      "visible": true,
      "visibleIf": "ifHVDLegislation",
      "requiredIf": "ifHVDLegislation"
    },
    "dcat:distribution": {
      "id": "dcat:distribution",
      "type": "distribution-editor",
      "distributionMode": "modal",
      "fileUpload": {
        "enabled": false,
        "uploadUrl": "https://www.data.gv.at/api/hub/store/{filename}",
        "method": "POST",
        "formField": "file",
        "responseType": "text",
        "responseUrlField": "url"
      },
      "label": {
        "de": "Distributionen",
        "en": "Distributions"
      },
      "hint": {
        "de": "Dateien, Endpunkte oder andere Zugangsmöglichkeiten zu diesem Datensatz",
        "en": "Files, endpoints or other access options for this dataset"
      },
      "order": 20,
      "visible": true
    }
  },
  "showProgress": true
}