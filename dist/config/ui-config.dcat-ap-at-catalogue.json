{
  "standard": "dcat-ap-at-catalogue",
  "version": "2.1",
  "rootClass": "dcat:Catalog",
  "shaclSource": "dcat-ap-at",
  "wizard": false,
  "groups": [
    {
      "id": "basic",
      "label": {
        "de": "Grundinformationen",
        "en": "Basic Information"
      },
      "fields": [
        "dct:title",
        "dct:description",
        "dct:identifier"
      ]
    },
    {
      "id": "contact",
      "label": {
        "de": "Kontakt & Herausgeber",
        "en": "Contact & Publisher"
      },
      "fields": [
        "dct:publisher",
        "foaf:homepage"
      ]
    },
    {
      "id": "access",
      "label": {
        "de": "Zugang",
        "en": "Access"
      },
      "fields": [
        "dcatap:availability",
        "dcatapatdmp:organizationId"
      ]
    }
  ],
  "fields": {
    "dct:title": {
      "type": "langstring",
      "required": true,
      "label": {
        "de": "Titel",
        "en": "Title"
      },
      "placeholder": {
        "de": "Titel des Katalogs",
        "en": "Catalogue title"
      },
      "errorMessages": {
        "required": {
          "de": "Titel ist erforderlich",
          "en": "Title is required"
        }
      },
      "defaultValue": {
        "de": "",
        "en": ""
      },
      "order": 1,
      "visible": true
    },
    "dct:description": {
      "type": "textarea",
      "required": true,
      "label": {
        "de": "Beschreibung",
        "en": "Description"
      },
      "placeholder": {
        "de": "Beschreibung des Katalogs und seines Inhalts …",
        "en": "Description of the catalogue and its content …"
      },
      "errorMessages": {
        "required": {
          "de": "Beschreibung ist erforderlich",
          "en": "Description is required"
        }
      },
      "order": 2,
      "visible": true
    },
    "dct:identifier": {
      "type": "text",
      "validate": "isURI",
      "label": {
        "de": "Katalog-ID",
        "en": "Catalogue ID"
      },
      "hint": {
        "de": "Eindeutige URI des Katalogs",
        "en": "Unique URI of the catalogue"
      },
      "errorMessages": {
        "isURI": {
          "de": "Kein gültiger URI",
          "en": "Not a valid URI"
        }
      },
      "order": 3,
      "visible": true
    },
    "dct:publisher": {
      "type": "object",
      "multiple": false,
      "required": true,
      "label": {
        "de": "Herausgeber",
        "en": "Publisher"
      },
      "hint": {
        "de": "Organisation oder Person, die den Katalog veröffentlicht",
        "en": "Organisation or person publishing the catalogue"
      },
      "order": 4,
      "visible": true,
      "subFields": [
        {
          "id": "foaf:name",
          "type": "text",
          "required": true,
          "label": {
            "de": "Name",
            "en": "Name"
          },
          "placeholder": {
            "de": "z.B. Stadt Wien",
            "en": "e.g. City of Vienna"
          }
        },
        {
          "id": "foaf:homepage",
          "type": "uri",
          "validate": "isURI",
          "label": {
            "de": "Webseite",
            "en": "Homepage"
          },
          "placeholder": {
            "de": "https://…",
            "en": "https://…"
          }
        },
        {
          "id": "foaf:mbox",
          "type": "text",
          "validate": "isEmail",
          "label": {
            "de": "E-Mail",
            "en": "Email"
          },
          "placeholder": {
            "de": "kontakt@beispiel.at",
            "en": "contact@example.at"
          }
        },
        {
          "id": "dct:type",
          "type": "select",
          "label": {
            "de": "Typ",
            "en": "Type"
          },
          "options": [
            {
              "value": "http://purl.org/adms/publishertype/LocalAuthority",
              "label": {
                "de": "Lokale Behörde",
                "en": "Local Authority"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/NationalAuthority",
              "label": {
                "de": "Nationale Behörde",
                "en": "National Authority"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/RegionalAuthority",
              "label": {
                "de": "Regionale Behörde",
                "en": "Regional Authority"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/Company",
              "label": {
                "de": "Unternehmen",
                "en": "Company"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/Academia",
              "label": {
                "de": "Forschungseinrichtung",
                "en": "Academia/Scientific organisation"
              }
            },
            {
              "value": "http://purl.org/adms/publishertype/NonProfitOrganisation",
              "label": {
                "de": "Non-Profit-Organisation",
                "en": "Non-Profit Organisation"
              }
            }
          ]
        }
      ]
    },
    "foaf:homepage": {
      "type": "uri",
      "validate": "isURI",
      "multiple": false,
      "label": {
        "de": "Webseite des Katalogs",
        "en": "Catalogue Homepage"
      },
      "hint": {
        "de": "URL der Katalog-Webseite",
        "en": "URL of the catalogue's website"
      },
      "placeholder": {
        "de": "https://…",
        "en": "https://…"
      },
      "order": 5,
      "visible": true
    },
    "dcatap:availability": {
      "type": "select",
      "label": {
        "de": "Verfügbarkeit",
        "en": "Availability"
      },
      "hint": {
        "de": "Wie lange wird dieser Katalog verfügbar bleiben?",
        "en": "How long will this catalogue remain available?"
      },
      "optionsSource": "/vocabularies/availability.json",
      "defaultValue": "http://data.europa.eu/r5r/availability/stable",
      "order": 6,
      "visible": true
    },
    "dcatapatdmp:organizationId": {
      "type": "text",
      "required": true,
      "label": {
        "de": "Organisations-ID",
        "en": "Organization ID"
      },
      "hint": {
        "de": "Eindeutige Kennung der herausgebenden Organisation",
        "en": "Unique identifier of the publishing organization"
      },
      "errorMessages": {
        "required": {
          "de": "Organisations-ID ist erforderlich",
          "en": "Organization ID is required"
        }
      },
      "order": 7,
      "visible": true
    }
  },
  "showProgress": false
}
